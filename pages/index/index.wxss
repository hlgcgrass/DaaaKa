/* ===== 应用外壳：侧边栏 + 内容区 ===== */
.app-shell { display: flex; flex-direction: row; min-height: 100vh; background: #f2f7f4; }

/* ===== 左侧深绿侧边栏 ===== */
.sidebar {
  width: 170rpx; min-width: 170rpx;
  background: linear-gradient(180deg, #1a3a2f 0%, #0d281f 100%);
  display: flex; flex-direction: column;
  flex-shrink: 0;
}
.sidebar-head {
  display: flex; flex-direction: column; align-items: center;
  padding: 36rpx 12rpx 24rpx;
}
.avatar {
  width: 80rpx; height: 80rpx; border-radius: 50%;
  background: rgba(255,255,255,0.15); border: 3rpx solid rgba(255,255,255,0.25);
}
.app-name { font-size: 22rpx; color: rgba(255,255,255,0.75); margin-top: 10rpx; }
.sidebar-list { flex: 1; overflow-y: auto; padding: 8rpx 0; }
.sb-item {
  display: flex; flex-direction: column; align-items: center;
  padding: 20rpx 8rpx; margin: 4rpx 8rpx; border-radius: 14rpx;
  position: relative; transition: background 0.2s;
}
.sb-item.active { background: rgba(255,255,255,0.14); }
.sb-item:active { background: rgba(255,255,255,0.08); }
.sb-icon { font-size: 36rpx; line-height: 1.2; }
.sb-name { font-size: 20rpx; color: rgba(255,255,255,0.7); margin-top: 6rpx; text-align: center; }
.sb-item.active .sb-name { color: #fff; font-weight: 600; }
.sb-badge {
  position: absolute; top: 8rpx; right: 6rpx;
  background: #ff5b5b; color: #fff; font-size: 18rpx;
  min-width: 30rpx; height: 30rpx; line-height: 30rpx;
  border-radius: 15rpx; text-align: center; padding: 0 6rpx;
}
.sb-sep { height: 1rpx; background: rgba(255,255,255,0.12); margin: 10rpx 16rpx; }
.sidebar-foot { padding: 16rpx 0; text-align: center; }
.sb-date { font-size: 18rpx; color: rgba(255,255,255,0.4); }

/* ===== 右侧内容区 ===== */
.main-area {
  flex: 1; min-width: 0; overflow-y: auto;
  padding: 24rpx 24rpx 200rpx;
}

/* ===== 面板头部（记账/便签共用） ===== */
.panel-header { margin-bottom: 20rpx; }
.ph-title { font-size: 38rpx; font-weight: 700; color: #333; display: block; }
.ph-sub { font-size: 24rpx; color: #999; margin-top: 4rpx; }

/* ===== Hero 进度条（习惯视图） ===== */
.hero {
  background: linear-gradient(135deg, #07c160, #16c97a);
  border-radius: 20rpx; padding: 24rpx 28rpx;
  color: #fff; box-shadow: 0 6rpx 18rpx rgba(7,193,96,0.2);
  margin-bottom: 16rpx;
}
.hero-title { display: flex; align-items: center; margin-bottom: 16rpx; }
.cat-icon { font-size: 40rpx; margin-right: 12rpx; }
.cat-name { font-size: 32rpx; font-weight: 700; }
.progress-row { display: flex; align-items: center; }
.progress-num { display: flex; align-items: baseline; margin-right: 24rpx; white-space: nowrap; }
.progress-num .big { font-size: 52rpx; font-weight: 700; }
.progress-num .slash { font-size: 28rpx; opacity: 0.85; margin: 0 4rpx; }
.progress-num .plabel { font-size: 22rpx; opacity: 0.85; margin-left: 8rpx; }
.bar { flex: 1; height: 16rpx; background: rgba(255,255,255,0.3); border-radius: 8rpx; overflow: hidden; }
.bar-fill { height: 100%; border-radius: 8rpx; transition: width 0.35s ease; }

/* ===== 习惯卡片列表 ===== */
.list { margin-top: 8rpx; }
.card { position: relative; overflow: hidden; border-radius: 16rpx; margin-bottom: 12rpx; display: block; }
.card-row { display: flex; align-items: center; }
.card-main { display: flex; align-items: center; flex: 1 1 0%; min-width: 0; overflow: hidden; }
.emoji { width: 60rpx; height: 60rpx; border-radius: 14rpx; background: #eef7f0; margin-right: 16rpx; flex-shrink: 0; }
.info { min-width: 0; flex: 1 1 0%; overflow: hidden; }
.name { font-size: 30rpx; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.sub { font-size: 23rpx; color: #999; margin-top: 2rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.check {
  width: 46rpx; height: 46rpx; border-radius: 50%;
  border: 3rpx solid #d9d9d9;
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 26rpx; font-weight: 700;
  margin-left: 12rpx; flex-shrink: 0; position: relative; overflow: visible;
}
.check.done { background: #07c160; border-color: #07c160; }
.check .ct { font-size: 22rpx; font-weight: 700; }
.check .ct-plus { font-size: 30rpx; font-weight: 700; color: #9aa0a6; }
.check-actions { display: flex; align-items: center; margin-left: 12rpx; flex-shrink: 0; position: relative; }
.check-actions .check + .check { margin-left: 12rpx; }

/* 星星特效 */
.star-burst { position: absolute; top: 50%; left: 50%; width: 0; height: 0; pointer-events: none; z-index: 10; }
.star-particle { position: absolute; left: 0; top: 0; font-size: 44rpx; opacity: 0; white-space: nowrap; }
.star-particle.s0{animation:starBurst0 0.9s ease-out forwards}.star-particle.s1{animation:starBurst1 0.9s ease-out forwards}
.star-particle.s2{animation:starBurst2 0.9s ease-out forwards}.star-particle.s3{animation:starBurst3 0.9s ease-out forwards}
.star-particle.s4{animation:starBurst4 0.9s ease-out forwards}.star-particle.s5{animation:starBurst5 0.9s ease-out forwards}
.star-particle.s6{animation:starBurst6 0.9s ease-out forwards}.star-particle.s7{animation:starBurst7 0.9s ease-out forwards}
@keyframes starBurst0{0%{opacity:0;transform:translate(-50%,-50%) scale(0.3)}25%{opacity:1;transform:translate(-50%,-50%) scale(1.7)}100%{opacity:0;transform:translate(calc(-50%+90rpx),-50%) scale(0.7)}}
@keyframes starBurst1{0%{opacity:0;transform:translate(-50%,-50%) scale(0.3)}25%{opacity:1;transform:translate(-50%,-50%) scale(1.7)}100%{opacity:0;transform:translate(calc(-50%+63rpx),calc(-50%+63rpx)) scale(0.7)}}
@keyframes starBurst2{0%{opacity:0;transform:translate(-50%,-50%) scale(0.3)}25%{opacity:1;transform:translate(-50%,-50%) scale(1.7)}100%{opacity:0;transform:translate(-50%,calc(-50%+90rpx)) scale(0.7)}}
@keyframes starBurst3{0%{opacity:0;transform:translate(-50%,-50%) scale(0.3)}25%{opacity:1;transform:translate(-50%,-50%) scale(1.7)}100%{opacity:0;transform:translate(calc(-50%-63rpx),calc(-50%+63rpx)) scale(0.7)}}
@keyframes starBurst4{0%{opacity:0;transform:translate(-50%,-50%) scale(0.3)}25%{opacity:1;transform:translate(-50%,-50%) scale(1.7)}100%{opacity:0;transform:translate(calc(-50%-90rpx),-50%) scale(0.7)}}
@keyframes starBurst5{0%{opacity:0;transform:translate(-50%,-50%) scale(0.3)}25%{opacity:1;transform:translate(-50%,-50%) scale(1.7)}100%{opacity:0;transform:translate(calc(-50%-63rpx),calc(-50%-63rpx)) scale(0.7)}}
@keyframes starBurst6{0%{opacity:0;transform:translate(-50%,-50%) scale(0.3)}25%{opacity:1;transform:translate(-50%,-50%) scale(1.7)}100%{opacity:0;transform:translate(-50%,calc(-50%-90rpx)) scale(0.7)}}
@keyframes starBurst7{0%{opacity:0;transform:translate(-50%,-50%) scale(0.3)}25%{opacity:1;transform:translate(-50%,-50%) scale(1.7)}100%{opacity:0;transform:translate(calc(-50%+63rpx),calc(-50%-63rpx)) scale(0.7)}}

/* 左滑删除 */
.del-slot { position:absolute;top:0;right:0;bottom:0;width:140rpx;background:#ff5b5b;color:#fff;font-size:28rpx;display:flex;align-items:center;justify-content:center;border-radius:0 16rpx 16rpx 0;}
.card-slide { position:relative;background:#fff;border-radius:16rpx;padding:16rpx 18rpx;box-shadow:0 2rpx 10rpx rgba(0,0,0,0.03);transition:transform 0.25s ease;z-index:1; }
.card-slide.open{transform:translateX(-140rpx)}
.card-slide.dragging { background:#f0f9ff; box-shadow:0 8rpx 24rpx rgba(0,0,0,0.12); transform:scale(1.02); z-index:10; }

.empty{text-align:center;padding:60rpx 0;color:#aaa}
.empty-emoji{font-size:72rpx}
.empty-title{font-size:30rpx;margin-top:14rpx;color:#666}
.empty-sub{font-size:24rpx;margin-top:8rpx}

.add-wrap{position:fixed;left:170rpx;right:0;bottom:0;padding:16rpx 24rpx calc(16rpx+env(safe-area-inset-bottom));background:#f2f7f4;z-index:10}
.add-btn{background:#07c160;color:#fff;border-radius:48rpx;font-size:30rpx;line-height:88rpx;width:100%;display:flex;align-items:center;justify-content:center;padding:0 24rpx;box-sizing:border-box;white-space:nowrap}
.add-btn::after{border:none}
.add-btn.disabled{background:#bdbdbd}
.quota{font-size:24rpx;opacity:0.85;margin-left:12rpx;flex-shrink:0}

/* 弹窗 */
.mask{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.45);display:flex;align-items:flex-end;z-index:50}
.sheet{background:#fff;width:100%;border-radius:32rpx 32rpx 0 0;padding:40rpx 56rpx calc(56rpx+env(safe-area-inset-bottom));max-height:88vh;overflow-y:auto;box-sizing:border-box}
.sheet-title{font-size:36rpx;font-weight:700;text-align:center;margin-top:20rpx;margin-bottom:36rpx;color:#222}
.field{margin:0 24rpx 28rpx}
.f-input{width:100%;height:88rpx;background:#f7f7f7;border:2rpx solid #e8e8e8;border-radius:16rpx;padding:0 32rpx;font-size:30rpx;box-sizing:border-box;color:#333;line-height:88rpx}
.f-input:focus{border-color:#07c160;background:#fff}
.ta-input{width:100%;min-height:140rpx;background:#f7f7f7;border:2rpx solid #e8e8e8;border-radius:16rpx;padding:24rpx 32rpx;font-size:28rpx;box-sizing:border-box;color:#333;line-height:1.6}
.f-ph{color:#bbb;font-size:28rpx}
.err{color:#e91e63;font-size:24rpx;margin-top:8rpx;display:block}
.field-label{font-size:27rpx;color:#444;margin:30rpx 0 16rpx;font-weight:600;padding-left:24rpx}

/* 选项分区卡片（图标/颜色等区块统一外框） */
.opt-block{background:#fafbfa;border:1rpx solid #eef0ee;border-radius:18rpx;padding:28rpx 28rpx 30rpx;margin:0 24rpx 24rpx}
.opt-block .field-label{margin-top:0;padding-left:0}

/* 分类选择 chips（添加弹窗） */
.cat-chips{display:flex;flex-wrap:wrap;gap:14rpx;padding-left:24rpx}
.cat-chip{
  padding:12rpx 26rpx;background:#fff;border:2rpx solid #e0e0e0;
  border-radius:44rpx;font-size:25rpx;color:#555;transition:all 0.15s
}
.cat-chip.sel{color:#fff}

/* 图标选择（横向滑动折叠） */
.emoji-row{white-space:nowrap;display:flex;gap:12rpx;height:80rpx}
.emoji-opt{display:inline-flex;align-items:center;justify-content:center;width:80rpx;height:80rpx;border-radius:18rpx;background:#fff;border:1rpx solid #eef0ee;flex-shrink:0}
.emoji-opt-img{width:54rpx;height:54rpx}
.emoji-opt.sel{background:#07c160;box-shadow:0 0 0 4rpx rgba(7,193,96,0.25)}

/* 颜色选择（横向滑动折叠，与图标一致） */
.color-row{display:flex;flex-wrap:nowrap;gap:22rpx;white-space:nowrap;height:60rpx}
.color-opt{width:60rpx;height:60rpx;border-radius:50%;flex-shrink:0;display:inline-block}
.color-opt.sel{box-shadow:0 0 0 4rpx rgba(0,0,0,0.15);border:4rpx solid #fff}
.inline{display:inline-block;width:130rpx;height:52rpx;line-height:52rpx;border-bottom:2rpx solid #ddd;padding:0 10rpx;text-align:center;font-size:24rpx;vertical-align:middle;background:#fff;border-radius:8rpx 8rpx 0 0}
.sheet-actions{display:flex;gap:20rpx;margin-top:36rpx;padding-top:8rpx}
.btn{flex:1;border-radius:48rpx;font-size:30rpx;line-height:88rpx;margin:0}
.btn::after{border:none}
.btn.ghost{background:#f0f0f0;color:#555}
.btn.primary{background:#07c160;color:#fff}

/* 计时打卡 */
.check .ck{color:#fff;font-size:28rpx;font-weight:700;line-height:1}
.check .play{color:#07c160;font-size:26rpx;line-height:1;font-weight:700}
.check .cd{color:#555;font-size:18rpx;font-weight:700;letter-spacing:-1px;line-height:1}
.check.timing{animation:timingPulse 1.4s ease-in-out infinite}
@keyframes timingPulse{
  0%,100%{box-shadow:0 0 0 0 rgba(7,193,96,0)}
  50%{box-shadow:0 0 0 6rpx rgba(7,193,96,0.12)}
}
.timer-row{padding-left:76rpx;margin-top:10rpx}
.timer-bar{height:10rpx;background:#eee;border-radius:6rpx;overflow:hidden}
.timer-bar-fill{height:100%;border-radius:6rpx;transition:width 0.4s linear}
.timer-meta{display:flex;align-items:center;margin-top:10rpx}
.timer-text{font-size:22rpx;color:#666}
.timer-hint{font-size:22rpx;color:#999}
.timer-actions{display:flex;align-items:center;gap:14rpx;margin-left:auto}
.timer-cancel{font-size:22rpx;color:#ff5b5b;padding:4rpx 8rpx}
.timer-done{font-size:22rpx;color:#07c160;padding:4rpx 16rpx;border:2rpx solid #07c160;border-radius:24rpx}
.timer-setting{background:#fafafa;border-radius:16rpx;padding:22rpx;margin:0 24rpx 20rpx;border:1rpx solid #eee}
.switch-line{display:flex;align-items:center;justify-content:space-between}
.ts-label{font-size:28rpx;color:#333}
.min-row{display:flex;align-items:center;margin-top:16rpx}
.min-label{font-size:25rpx;color:#555}
.min-input{width:110rpx;height:64rpx;margin:0 12rpx;background:#fff;border:2rpx solid #e0e0e0;border-radius:12rpx;text-align:center;font-size:27rpx;color:#333}
.min-input:focus{border-color:#07c160}
.min-unit{font-size:25rpx;color:#666}
.chips{display:flex;gap:12rpx;flex-wrap:wrap;width:100%;margin-top:16rpx}
.chip{padding:10rpx 22rpx;background:#fff;border:2rpx solid #e0e0e0;border-radius:44rpx;font-size:24rpx;color:#555}
.chip.sel{color:#fff}
.timer-tip{font-size:21rpx;color:#999;margin-top:12rpx;line-height:1.5}

/* 庆祝特效 */
.celebrate{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.55);display:flex;align-items:center;justify-content:center;z-index:100}
.confetti-layer{position:absolute;top:0;left:0;right:0;bottom:0;overflow:hidden;pointer-events:none}
.confetti{position:absolute;top:-40rpx;width:16rpx;height:16rpx;animation-name:fall;animation-timing-function:linear;animation-iteration-count:infinite}
@keyframes fall{0%{transform:translateY(0) rotate(0deg);opacity:1}100%{transform:translateY(1800rpx) rotate(720deg);opacity:0.7}}
.celebrate-card{position:relative;z-index:2;background:#fff;border-radius:28rpx;padding:56rpx 48rpx;width:560rpx;text-align:center;box-sizing:border-box;animation:pop 0.6s cubic-bezier(0.34,1.56,0.64,1) both}
@keyframes pop{0%{transform:scale(0.7);opacity:0}60%{transform:scale(1.06);opacity:1}100%{transform:scale(1);opacity:1}}
.celebrate-emoji{font-size:96rpx;animation:pulse 1.2s ease-in-out infinite}
@keyframes pulse{0%,100%{transform:scale(1)}50%{transform:scale(1.18)}}
.celebrate-title{font-size:38rpx;font-weight:700;color:#07c160;margin-top:16rpx}
.celebrate-sub{font-size:26rpx;color:#666;margin-top:16rpx}
.celebrate-pill{display:inline-block;margin-top:28rpx;background:#eef7f0;color:#07c160;font-size:24rpx;padding:12rpx 24rpx;border-radius:40rpx}

/* ===== 记账视图样式 ===== */
.summary-cards{display:flex;gap:16rpx;margin-bottom:20rpx}
.sum-card{flex:1;background:#fff;border-radius:16rpx;padding:20rpx;box-shadow:0 2rpx 8rpx rgba(0,0,0,0.04)}
.sum-label{font-size:22rpx;color:#999;display:block}
.sum-amount{font-size:40rpx;font-weight:700;color:#333;margin-top:6rpx}
.sum-count{font-size:40rpx;font-weight:700;color:#07c160;margin-top:6rpx}
.section{background:#fff;border-radius:16rpx;padding:20rpx;margin-bottom:16rpx;box-shadow:0 2rpx 8rpx rgba(0,0,0,0.04)}
.sec-title{font-size:28rpx;font-weight:600;color:#333;margin-bottom:14rpx;display:block}
.cat-stat-row{display:flex;align-items:center;margin-bottom:12rpx}
.cs-icon{font-size:28rpx;margin-right:10rpx}
.cs-name{font-size:24rpx;color:#666;width:80rpx;flex-shrink:0}
.cs-bar-wrap{flex:1;height:12rpx;background:#eee;border-radius:6rpx;overflow:hidden;margin:0 12rpx}
.cs-bar-fill{height:100%;border-radius:6rpx}
.cs-amount{font-size:24rpx;color:#333;font-weight:600;flex-shrink:0}
.acc-btn{background:#FDCB6E!important;color:#333!important}
.acc-list{margin-top:12rpx}
.acc-group{background:#fff;border-radius:16rpx;padding:20rpx;margin-bottom:14rpx;box-shadow:0 2rpx 8rpx rgba(0,0,0,0.04)}
.acc-date{font-size:26rpx;font-weight:600;color:#333}
.acc-day-total{font-size:22rpx;color:#999;float:right}
.acc-item{display:flex;align-items:center;padding:12rpx 0;border-bottom:1rpx solid #f0f0f0}
.acc-item:last-child{border-bottom:none}
.aci-icon{font-size:30rpx;margin-right:12rpx}
.aci-info{flex:1;min-width:0}
.aci-note{font-size:26rpx;color:#333;display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.aci-cat{font-size:20rpx;color:#bbb}
.aci-amount{font-size:28rpx;font-weight:600;color:#ff5b5b;flex-shrink:0;margin-left:12rpx}
.aci-del{font-size:24rpx;color:#ccc;padding:8rpx;margin-left:8rpx}

/* ===== 便签视图样式 ===== */
.note-btn{background:#74B9FF!important;color:#fff!important}
.note-grid{display:flex;flex-wrap:wrap;gap:16rpx;margin-top:12rpx}
.note-card{
  width:calc(50% - 8rpx);border-radius:16rpx;padding:20rpx;
  box-shadow:0 2rpx 10rpx rgba(0,0,0,0.06);
  position:relative; box-sizing:border-box;
}
.note-card.done{opacity:0.6}
.nc-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:10rpx}
.nc-pin{font-size:22rpx}
.nc-del{font-size:22rpx;color:#ccc;padding:4rpx}
.nc-text{font-size:26rpx;color:#333;line-height:1.5;display:block;word-break:break-all}
.nc-text.done-text{text-decoration:line-through;color:#999}
.nc-bot{display:flex;justify-content:space-between;align-items:center;margin-top:14rpx}
.nc-time{font-size:18rpx;color:#bbb}
.nc-pin-btn{font-size:18rpx;color:#07c160}

/* ===== 待办视图样式 ===== */
.hero-top{display:flex;flex-direction:column}
.title{font-size:36rpx;font-weight:700}
.sub.muted{font-size:24rpx;opacity:0.9;margin-top:8rpx}

.todo-card{display:flex;align-items:center;background:#fff;border-radius:20rpx;padding:24rpx;margin-bottom:16rpx;box-shadow:0 2rpx 12rpx rgba(0,0,0,0.04)}
.todo-check{width:44rpx;height:44rpx;border-radius:50%;border:3rpx solid #d9d9d9;flex-shrink:0;display:flex;align-items:center;justify-content:center;color:#fff;font-size:26rpx;font-weight:700}
.todo-check.done{background:#07c160;border-color:#07c160}
.todo-text{flex:1;margin-left:20rpx;font-size:30rpx;color:#333;word-break:break-all}
.todo-text.done{color:#bbb;text-decoration:line-through}
.todo-del{color:#ccc;font-size:32rpx;padding:0 8rpx;flex-shrink:0}
.todo-del:active{color:#ff5b5b}

.clear-row{text-align:center;margin:8rpx 0 16rpx}
.clear-btn{font-size:24rpx;color:#999}

.todo-add-wrap{position:fixed;left:170rpx;right:0;bottom:0;display:flex;align-items:center;gap:16rpx;padding:16rpx 24rpx calc(16rpx+env(safe-area-inset-bottom));background:#f2f7f4;border-top:1rpx solid #e6efe9;z-index:10}
.todo-add-input{flex:1;height:80rpx;background:#fff;border:2rpx solid #e0e0e0;border-radius:40rpx;padding:0 28rpx;font-size:28rpx;color:#333;box-sizing:border-box}
.todo-add-input:focus{border-color:#07c160}
.todo-add-btn{flex-shrink:0;background:#07c160;color:#fff;border-radius:40rpx;font-size:28rpx;line-height:80rpx;padding:0 36rpx;margin:0}
.todo-add-btn::after{border:none}

/* ===== 教育时政视图样式 ===== */
.edu-meta{display:flex;align-items:center;justify-content:space-between;padding:8rpx 8rpx 16rpx}
.edu-date{font-size:24rpx;color:#999}
.edu-tag{font-size:22rpx;padding:4rpx 16rpx;border-radius:20rpx}
.edu-tag.real{background:#e8f8ee;color:#07c160}
.edu-tag.fallback{background:#fff7e6;color:#fa8c16}
.edu-tag.err{background:#fff1f0;color:#f5222d}
.edu-tag.builtin{background:#e6f7ff;color:#1677ff}
.edu-list{display:flex;flex-direction:column}
.edu-item{display:flex;align-items:flex-start;padding:24rpx 8rpx;border-bottom:1rpx solid #f0f0f0;background:#fff}
.edu-item:active{background:#fafafa}
.edu-dot{width:14rpx;height:14rpx;border-radius:50%;background:#d4380d;margin-top:12rpx;margin-right:20rpx;flex-shrink:0}
.edu-body{flex:1;display:flex;flex-direction:column}
.edu-title{font-size:28rpx;color:#222;line-height:1.5}
.edu-src{font-size:22rpx;color:#999;margin-top:8rpx}
.edu-arrow{color:#ccc;font-size:36rpx;margin-left:10rpx;flex-shrink:0}

/* 教育时政 - 详情弹窗 */
.edu-detail-sheet{max-height:82vh;padding:56rpx 64rpx calc(40rpx+env(safe-area-inset-bottom))}
.edu-detail-header{margin-bottom:28rpx;border-bottom:1rpx solid #eee;padding-bottom:24rpx}
.edu-detail-title{font-size:34rpx;color:#111;font-weight:700;line-height:1.55;display:block;margin-bottom:16rpx}
.edu-detail-src{font-size:24rpx;color:#999}
.edu-detail-body{max-height:54vh;padding:8rpx 0 0;margin-top:12rpx}
.edu-detail-content{font-size:29rpx;color:#333;line-height:2.0;white-space:pre-wrap;word-break:break-all;letter-spacing:0.5rpx}
