.page { padding: 24rpx 24rpx 200rpx; }

.hero {
  background: linear-gradient(135deg, #07c160, #16c97a);
  border-radius: 24rpx;
  padding: 32rpx;
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.25);
}
.hero-top { display: flex; flex-direction: column; }
.date { font-size: 26rpx; opacity: 0.9; }
.identity { font-size: 34rpx; font-weight: 600; margin-top: 8rpx; }
.identity.muted { font-weight: 400; opacity: 0.9; font-size: 26rpx; }

.progress-row { display: flex; align-items: center; margin-top: 28rpx; }
.progress-num { display: flex; align-items: baseline; margin-right: 24rpx; white-space: nowrap; }
.progress-num .big { font-size: 56rpx; font-weight: 700; }
.progress-num .slash { font-size: 30rpx; opacity: 0.85; margin: 0 4rpx; }
.progress-num .plabel { font-size: 24rpx; opacity: 0.85; margin-left: 8rpx; }
.bar { flex: 1; height: 16rpx; background: rgba(255, 255, 255, 0.3); border-radius: 8rpx; overflow: hidden; }
.bar-fill { height: 100%; background: #fff; border-radius: 8rpx; }
.quotes { margin-top: 24rpx; }
.quote { display: block; font-size: 24rpx; line-height: 1.5; opacity: 0; transition: opacity 0.3s ease; }
.quote.show { opacity: 0.92; }
.quote-from { display: block; font-size: 22rpx; text-align: right; opacity: 0; transition: opacity 0.3s ease; margin-top: 8rpx; }
.quote-from.show { opacity: 0.7; }

.list { margin-top: 24rpx; }
.card {
  position: relative;
  overflow: hidden;
  border-radius: 20rpx;
  margin-bottom: 18rpx;
  display: block;
}
.card-row { display: flex; align-items: center; }
.card-main { display: flex; align-items: center; flex: 1 1 0%; min-width: 0; overflow: hidden; }
.emoji {
  width: 72rpx; height: 72rpx; border-radius: 18rpx;
  background: #eef7f0;
  margin-right: 20rpx; flex-shrink: 0;
}
.info { min-width: 0; flex: 1 1 0%; overflow: hidden; }
.name { font-size: 32rpx; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.sub { font-size: 24rpx; color: #999; margin-top: 4rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.streak { font-size: 24rpx; color: #bbb; margin-top: 8rpx; }
.streak.on { color: #ff7043; }

.dots { display: flex; gap: 8rpx; margin-top: 16rpx; padding-left: 92rpx; flex-wrap: wrap; }
.dot { width: 22rpx; height: 22rpx; border-radius: 50%; background: #eee; flex-shrink: 0; }
.dot.on { /* color set inline */ }

.check {
  width: 48rpx; height: 48rpx; border-radius: 50%;
  border: 3rpx solid #d9d9d9;
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 28rpx; font-weight: 700;
  margin-left: 16rpx; flex-shrink: 0;
  position: relative;
  overflow: visible;
}
.check.done { /* color set inline */ }

/* 打卡星星绽放特效：8 个固定方向 keyframes，避免 CSS 变量在 keyframes 中的兼容问题 */
.star-burst { position: absolute; top: 50%; left: 50%; width: 0; height: 0; pointer-events: none; z-index: 10; }
.star-particle {
  position: absolute; left: 0; top: 0;
  font-size: 46rpx; opacity: 0;
  white-space: nowrap;
}
.star-particle.s0 { animation: starBurst0 0.9s ease-out forwards; }
.star-particle.s1 { animation: starBurst1 0.9s ease-out forwards; }
.star-particle.s2 { animation: starBurst2 0.9s ease-out forwards; }
.star-particle.s3 { animation: starBurst3 0.9s ease-out forwards; }
.star-particle.s4 { animation: starBurst4 0.9s ease-out forwards; }
.star-particle.s5 { animation: starBurst5 0.9s ease-out forwards; }
.star-particle.s6 { animation: starBurst6 0.9s ease-out forwards; }
.star-particle.s7 { animation: starBurst7 0.9s ease-out forwards; }
@keyframes starBurst0 { 0%{opacity:0;transform:translate(-50%,-50%) scale(0.3);} 25%{opacity:1;transform:translate(-50%,-50%) scale(1.7);} 100%{opacity:0;transform:translate(calc(-50% + 90rpx),-50%) scale(0.7);} }
@keyframes starBurst1 { 0%{opacity:0;transform:translate(-50%,-50%) scale(0.3);} 25%{opacity:1;transform:translate(-50%,-50%) scale(1.7);} 100%{opacity:0;transform:translate(calc(-50% + 63rpx),calc(-50% + 63rpx)) scale(0.7);} }
@keyframes starBurst2 { 0%{opacity:0;transform:translate(-50%,-50%) scale(0.3);} 25%{opacity:1;transform:translate(-50%,-50%) scale(1.7);} 100%{opacity:0;transform:translate(-50%,calc(-50% + 90rpx)) scale(0.7);} }
@keyframes starBurst3 { 0%{opacity:0;transform:translate(-50%,-50%) scale(0.3);} 25%{opacity:1;transform:translate(-50%,-50%) scale(1.7);} 100%{opacity:0;transform:translate(calc(-50% - 63rpx),calc(-50% + 63rpx)) scale(0.7);} }
@keyframes starBurst4 { 0%{opacity:0;transform:translate(-50%,-50%) scale(0.3);} 25%{opacity:1;transform:translate(-50%,-50%) scale(1.7);} 100%{opacity:0;transform:translate(calc(-50% - 90rpx),-50%) scale(0.7);} }
@keyframes starBurst5 { 0%{opacity:0;transform:translate(-50%,-50%) scale(0.3);} 25%{opacity:1;transform:translate(-50%,-50%) scale(1.7);} 100%{opacity:0;transform:translate(calc(-50% - 63rpx),calc(-50% - 63rpx)) scale(0.7);} }
@keyframes starBurst6 { 0%{opacity:0;transform:translate(-50%,-50%) scale(0.3);} 25%{opacity:1;transform:translate(-50%,-50%) scale(1.7);} 100%{opacity:0;transform:translate(-50%,calc(-50% - 90rpx)) scale(0.7);} }
@keyframes starBurst7 { 0%{opacity:0;transform:translate(-50%,-50%) scale(0.3);} 25%{opacity:1;transform:translate(-50%,-50%) scale(1.7);} 100%{opacity:0;transform:translate(calc(-50% + 63rpx),calc(-50% - 63rpx)) scale(0.7);} }

/* 左滑删除：内容层位移，露出右侧删除按钮 */
.del-slot {
  position: absolute; top: 0; right: 0; bottom: 0;
  width: 140rpx;
  background: #ff5b5b;
  color: #fff; font-size: 28rpx;
  display: flex; align-items: center; justify-content: center;
}
.card-slide {
  position: relative;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  transition: transform 0.25s ease;
  z-index: 1;
}
.card-slide.open { transform: translateX(-140rpx); }

.empty { text-align: center; padding: 80rpx 0; color: #aaa; }
.empty-emoji { font-size: 80rpx; }
.empty-title { font-size: 32rpx; margin-top: 16rpx; color: #666; }
.empty-sub { font-size: 26rpx; margin-top: 8rpx; }

.add-wrap {
  position: fixed; left: 0; right: 0; bottom: 0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #f2f7f4;
}
.add-btn {
  background: #07c160; color: #fff; border-radius: 48rpx;
  font-size: 30rpx; line-height: 88rpx; width: 100%;
  display: flex; align-items: center; justify-content: center;
  padding: 0 24rpx; box-sizing: border-box; white-space: nowrap;
}
.add-btn::after { border: none; }
.add-btn.disabled { background: #bdbdbd; }
.quota { font-size: 24rpx; opacity: 0.85; margin-left: 12rpx; flex-shrink: 0; }

.mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0, 0, 0, 0.45); display: flex; align-items: flex-end; z-index: 50; }
.sheet { background: #fff; width: 100%; border-radius: 28rpx 28rpx 0 0; padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom)); max-height: 85vh; overflow-y: auto; }
.sheet-title { font-size: 34rpx; font-weight: 700; text-align: center; margin-bottom: 24rpx; }
.field { margin-bottom: 20rpx; }
.f-input {
  width: 100%; height: 88rpx;
  background: #f7f7f7; border: 2rpx solid #e0e0e0; border-radius: 14rpx;
  padding: 0 24rpx; font-size: 30rpx; box-sizing: border-box;
  color: #333; line-height: 88rpx;
}
.f-input:focus { border-color: #07c160; background: #fff; }
.f-ph { color: #bbb; font-size: 30rpx; }
.err { color: #e91e63; font-size: 24rpx; margin-top: 8rpx; display: block; }
.field-label { font-size: 26rpx; color: #666; margin: 16rpx 0 12rpx; }
.emoji-row { white-space: nowrap; }
.emoji-opt { display: inline-flex; align-items: center; justify-content: center; width: 80rpx; height: 80rpx; border-radius: 16rpx; margin-right: 12rpx; background: #f5f5f5; }
.emoji-opt-img { width: 56rpx; height: 56rpx; }
.emoji-opt.sel { background: #07c160; box-shadow: 0 0 0 4rpx rgba(7, 193, 96, 0.25); }
.color-row { display: flex; gap: 20rpx; flex-wrap: wrap; }
.color-opt { width: 60rpx; height: 60rpx; border-radius: 50%; }
.color-opt.sel { box-shadow: 0 0 0 4rpx rgba(0, 0, 0, 0.12); border: 4rpx solid #fff; }
.stack-preview { font-size: 26rpx; color: #555; background: #f9f9f9; border-radius: 14rpx; padding: 20rpx; line-height: 2.2; word-break: break-all; }
.inline { display: inline-block; width: 140rpx; height: 52rpx; line-height: 52rpx; border-bottom: 2rpx solid #ccc; padding: 0 8rpx; text-align: center; font-size: 26rpx; vertical-align: baseline; background: #fff; border-radius: 6rpx 6rpx 0 0; }
.sheet-actions { display: flex; gap: 20rpx; margin-top: 32rpx; }
.btn { flex: 1; border-radius: 48rpx; font-size: 30rpx; line-height: 88rpx; margin: 0; }
.btn::after { border: none; }
.btn.ghost { background: #f0f0f0; color: #333; }
.btn.primary { background: #07c160; color: #fff; }

.celebrate { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0, 0, 0, 0.55); display: flex; align-items: center; justify-content: center; z-index: 100; }
.confetti-layer { position: absolute; top: 0; left: 0; right: 0; bottom: 0; overflow: hidden; pointer-events: none; }
.confetti { position: absolute; top: -40rpx; width: 16rpx; height: 16rpx; animation-name: fall; animation-timing-function: linear; animation-iteration-count: infinite; }
@keyframes fall {
  0% { transform: translateY(0) rotate(0deg); opacity: 1; }
  100% { transform: translateY(1800rpx) rotate(720deg); opacity: 0.7; }
}
.celebrate-card {
  position: relative; z-index: 2;
  background: #fff; border-radius: 28rpx; padding: 56rpx 48rpx;
  width: 560rpx; text-align: center; box-sizing: border-box;
  animation: pop 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}
@keyframes pop {
  0% { transform: scale(0.7); opacity: 0; }
  60% { transform: scale(1.06); opacity: 1; }
  100% { transform: scale(1); opacity: 1; }
}
.celebrate-emoji { font-size: 96rpx; animation: pulse 1.2s ease-in-out infinite; }
@keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.18); } }
.celebrate-title { font-size: 38rpx; font-weight: 700; color: #07c160; margin-top: 16rpx; }
.celebrate-sub { font-size: 26rpx; color: #666; margin-top: 16rpx; }
.celebrate-pill { display: inline-block; margin-top: 28rpx; background: #eef7f0; color: #07c160; font-size: 24rpx; padding: 12rpx 24rpx; border-radius: 40rpx; }

/* ===== 计时打卡 ===== */
.check .ck { color: #fff; font-size: 30rpx; font-weight: 700; line-height: 1; }
.check .play { color: #c2c2c2; font-size: 26rpx; line-height: 1; }
.check .cd { color: #555; font-size: 20rpx; font-weight: 700; letter-spacing: -1rpx; line-height: 1; }
.check.timing { animation: timingPulse 1.4s ease-in-out infinite; }
@keyframes timingPulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(7, 193, 96, 0.0); }
  50% { box-shadow: 0 0 0 6rpx rgba(7, 193, 96, 0.12); }
}

.timer-row { padding-left: 92rpx; margin-top: 14rpx; }
.timer-bar { flex: 1; height: 12rpx; background: #eee; border-radius: 6rpx; overflow: hidden; }
.timer-bar-fill { height: 100%; border-radius: 6rpx; transition: width 0.4s linear; }
.timer-meta { display: flex; align-items: center; margin-top: 10rpx; }
.timer-text { font-size: 24rpx; color: #666; }
.timer-hint { font-size: 24rpx; color: #999; }
.timer-actions { display: flex; align-items: center; gap: 16rpx; margin-left: auto; }
.timer-cancel { font-size: 24rpx; color: #ff5b5b; padding: 4rpx 8rpx; }
.timer-done { font-size: 24rpx; color: #07c160; padding: 4rpx 18rpx; border: 2rpx solid #07c160; border-radius: 24rpx; }

/* 添加弹窗 - 计时设置 */
.timer-setting { background: #f9f9f9; border-radius: 14rpx; padding: 20rpx; margin-bottom: 20rpx; }
.switch-line { display: flex; align-items: center; justify-content: space-between; }
.ts-label { font-size: 28rpx; color: #333; }
.min-row { display: flex; align-items: center; margin-top: 16rpx; }
.min-label { font-size: 26rpx; color: #666; }
.min-input {
  width: 110rpx; height: 64rpx; margin: 0 12rpx;
  background: #fff; border: 2rpx solid #e0e0e0; border-radius: 10rpx;
  text-align: center; font-size: 28rpx; color: #333;
}
.min-input:focus { border-color: #07c160; }
.min-unit { font-size: 26rpx; color: #666; }
.chips { display: flex; gap: 12rpx; flex-wrap: wrap; width: 100%; margin-top: 14rpx; }
.chip {
  padding: 8rpx 22rpx; background: #fff; border: 2rpx solid #e0e0e0;
  border-radius: 40rpx; font-size: 24rpx; color: #666;
}
.chip.sel { color: #fff; }
.timer-tip { font-size: 22rpx; color: #999; margin-top: 12rpx; line-height: 1.4; }
