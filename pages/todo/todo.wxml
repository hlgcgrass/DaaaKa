<view class="page">
  <!-- 顶部概览 -->
  <view class="hero">
    <view class="hero-top">
      <text class="title">待办清单</text>
      <text class="sub muted">随手记下，做完勾掉</text>
    </view>
    <view class="progress-row">
      <view class="progress-num">
        <text class="big">{{doneCount}}</text><text class="slash">/{{total}}</text>
        <text class="plabel">已完成</text>
      </view>
      <view class="bar">
        <view class="bar-fill" style="width:{{ total ? doneCount / total * 100 : 0 }}%"></view>
      </view>
    </view>
  </view>

  <!-- 待办列表 -->
  <view class="list">
    <view class="todo-card" wx:for="{{todos}}" wx:key="id">
      <view class="check {{item.done ? 'done' : ''}}" bindtap="toggle" data-id="{{item.id}}">
        <text wx:if="{{item.done}}">✓</text>
      </view>
      <view class="todo-text {{item.done ? 'done' : ''}}">{{item.text}}</view>
      <text class="del" catchtap="removeTodo" data-id="{{item.id}}">✕</text>
    </view>

    <view class="empty" wx:if="{{total === 0}}">
      <view class="empty-emoji">📝</view>
      <view class="empty-title">还没有待办</view>
      <view class="empty-sub">在下方输入框写一条，回车或点「添加」</view>
    </view>
  </view>

  <view class="clear-row" wx:if="{{doneCount > 0}}">
    <text class="clear-btn" bindtap="clearDone">清除已完成的 {{doneCount}} 项</text>
  </view>

  <!-- 底部添加栏 -->
  <view class="add-bar">
    <input class="add-input" type="text" placeholder="写一条待办…" value="{{inputText}}"
           bindinput="onInput" confirm-type="done" bindconfirm="onConfirm" maxlength="100" />
    <button class="add-btn" bindtap="addTodo">添加</button>
  </view>
</view>
