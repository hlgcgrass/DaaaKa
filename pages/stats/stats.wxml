<view class="page">
  <!-- 今日总览 -->
  <view class="overview">
    <view class="ov-item"><text class="ov-num">{{done}}/{{total}}</text><text class="ov-label">今日打卡</text></view>
    <view class="ov-item"><text class="ov-num">{{rate}}%</text><text class="ov-label">完成率</text></view>
    <view class="ov-item"><text class="ov-num">{{total}}</text><text class="ov-label">习惯数</text></view>
  </view>

  <!-- 打卡日历 -->
  <view class="section-title cal-title" bindtap="toggleCalendar">打卡日历 <text class="cal-arrow-icon">{{calendarExpanded ? '▲' : '▼'}}</text></view>
  <view class="cal-card" wx:if="{{calendarExpanded}}">
    <view class="cal-head">
      <view class="cal-arrow" bindtap="prevMonth">‹</view>
      <view class="cal-month">{{monthLabel}}</view>
      <view class="cal-arrow" bindtap="nextMonth">›</view>
    </view>
    <view class="cal-week">
      <text class="cal-wd" wx:for="{{weekHeads}}" wx:key="*this">{{item}}</text>
    </view>
    <view class="cal-grid {{calAnim}}" bindtouchstart="onCalTouchStart" bindtouchend="onCalTouchEnd">
      <view wx:for="{{calCells}}" wx:key="index"
            class="cal-cell {{item.empty ? 'empty' : ''}} {{item.isToday ? 'today' : ''}}">
        <block wx:if="{{!item.empty}}">
          <text class="cal-day">{{item.day}}</text>
          <view class="cal-mark {{item.status}}">
            <text wx:if="{{item.status === 'full'}}">✓</text>
            <text wx:elif="{{item.status === 'miss'}}">✕</text>
          </view>
        </block>
      </view>
    </view>
    <view class="cal-legend">
      <view class="lg-item"><view class="lg full">✓</view><text class="lg-txt">全完成</text></view>
      <view class="lg-item"><view class="lg part"></view><text class="lg-txt">部分</text></view>
      <view class="lg-item"><view class="lg miss">✕</view><text class="lg-txt">未打卡</text></view>
    </view>
  </view>

  <!-- 专题统计：按分类分组 -->
  <view class="section-title">专题统计</view>
  <view class="cat-section" wx:for="{{categorySections}}" wx:key="id" wx:for-item="cat">
    <view class="cat-head" bindtap="toggleCat" data-idx="{{index}}" style="border-left-color:{{cat.color}}">
      <text class="cat-icon">{{cat.icon}}</text>
      <text class="cat-name">{{cat.name}}</text>
      <text class="cat-prog">今日 {{cat.done}}/{{cat.total}}</text>
      <text class="cat-arrow">{{cat.expanded ? '▲' : '▼'}}</text>
    </view>
    <view class="habits" wx:if="{{cat.expanded && cat.habits.length > 0}}">
      <view class="hcard" wx:for="{{cat.habits}}" wx:key="id" wx:for-item="item">
        <!-- 头部：emoji + 名称 + 数据 -->
        <view class="hcard-head">
          <image class="h-emoji" src="{{item.emoji}}" mode="aspectFit" />
          <text class="h-name">{{item.name}}</text>
          <text class="h-meta">🔥{{item.streak}}天 · 🏆{{item.best}}天 · 共{{item.count}}天<text wx:if="{{item.isTimer}}"> · ⏱今日{{item.todayDurationText}}</text><text wx:if="{{item.isCount}}"> · ✓{{item.totalCount}}次</text></text>
        </view>

        <!-- 打卡链条（今天在最左，往右=过去） -->
        <view class="chain-wrap">
          <scroll-view class="chain-scroll" scroll-x="true" show-scrollbar="{{false}}">
            <view class="chain">
              <view wx:for="{{item.chain}}" wx:for-item="c" wx:key="date"
                    class="link {{c.done ? 'done' : ''}} {{c.isToday ? 'today' : ''}}"
                    style="{{c.done ? 'background:' + item.color : ''}}">
                <text wx:if="{{c.isToday}}" class="link-today">今</text>
              </view>
            </view>
          </scroll-view>
        </view>

        <!-- 每日计时时长（最近 7 天） -->
        <view class="dur-week" wx:if="{{item.isTimer}}">
          <view class="dur-row" wx:for="{{item.week}}" wx:for-item="w" wx:key="label">
            <text class="dur-day">{{w.label}}</text>
            <text class="dur-val {{w.has ? 'on' : ''}}">{{w.text}}</text>
          </view>
        </view>

      </view>
    </view>
    <view class="empty muted" wx:elif="{{cat.expanded}}">该专题还没有打卡事项</view>
  </view>

  <!-- 数据管理 -->
  <view class="section-title">数据管理</view>
  <view class="clear-card">
    <button class="clear-btn" bindtap="onClearAll">清空所有数据</button>
    <text class="clear-tip">删除所有习惯、打卡记录和头像，重置为初始状态</text>
  </view>
</view>
